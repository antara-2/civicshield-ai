# Local SQLite works out of the box. For docker-compose, use the PostGIS URL from README.
CIVICSHIELD_DATABASE_URL=sqlite:///./data/civicshield.db
CIVICSHIELD_DEMO_TOKEN=demo-civicshield-token
CIVICSHIELD_SEED_DEMO=true
CIVICSHIELD_MEDIA_DIR=./data/media
CIVICSHIELD_WEATHER_SOURCE=SIMULATED_DEMO_WEATHER
